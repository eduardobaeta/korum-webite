# Canonical site origin (e.g. https://example.com). Optional on Vercel, where the
# production domain is detected from VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# Server-only webhook that receives visit requests and newsletter sign-ups as JSON.
# Google Apps Script (docs/integrations/google-sheets-lead-webhook.md):
#   https://script.google.com/macros/s/<deployment-id>/exec?secret=<WEBHOOK_SECRET>
LEAD_WEBHOOK_URL=

# Optional bearer token, for webhooks that read the Authorization header (not Apps Script).
LEAD_WEBHOOK_TOKEN=

# Upstash Redis (Vercel Marketplace) for distributed rate limiting of the form endpoints.
# Without them the endpoints fall back to per-instance in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site origin (e.g. https://example.com). Optional on Vercel, where the
# production domain is detected from VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# Lead destinations (docs/integrations/leads.md). The forms answer 503 until all of them are set.
# Attio CRM: every lead becomes a person; visit requests also open a deal owned by this workspace member.
ATTIO_API_TOKEN=
ATTIO_DEAL_OWNER_EMAIL=
# Brevo: newsletter sign-ups join this list, which sends "A Pauta".
BREVO_API_TOKEN=
BREVO_NEWSLETTER_LIST_ID=

# Upstash Redis (Vercel Marketplace) for distributed rate limiting of the form endpoints.
# Without them the endpoints fall back to per-instance in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

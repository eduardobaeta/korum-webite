---
interface Props {
  items: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-2', className]}>
  {items.map((item) => (
    <li class="type-tag rounded-full bg-muted px-4 py-2.5 text-foreground">{item}</li>
  ))}
</ul>

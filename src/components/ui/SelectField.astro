---
import type { HTMLAttributes } from 'astro/types';
import ChevronDownIcon from '@/assets/icons/chevron-down.svg';
import type { SelectOption } from '@/components/types';

type Props = Omit<HTMLAttributes<'select'>, 'id' | 'name' | 'class'> & {
  id: string;
  label: string;
  name: string;
  options: readonly SelectOption[];
  class?: string;
};

const { id, label, name, options, class: className, ...selectAttributes } = Astro.props;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class="type-eyebrow text-foreground">
    {label}
  </label>
  <div class="relative">
    <select id={id} name={name} class="form-control type-field h-10 appearance-none pr-10" {...selectAttributes}>
      {options.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
    <ChevronDownIcon
      class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground"
      aria-hidden="true"
    />
  </div>
</div>

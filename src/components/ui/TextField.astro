---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'id' | 'name' | 'class'> & {
  id: string;
  label: string;
  name: string;
  hideLabel?: boolean;
  class?: string;
};

const { id, label, name, hideLabel = false, class: className, type = 'text', ...inputAttributes } = Astro.props;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class:list={['type-eyebrow text-foreground', hideLabel && 'sr-only']}>
    {label}
  </label>
  <input id={id} name={name} type={type} class="form-control type-field h-10" {...inputAttributes} />
</div>

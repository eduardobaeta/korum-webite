---
interface Props {
  index: string;
  size: 'xl' | 'lg';
}

const { index, size } = Astro.props;
const indexClass = size === 'xl' ? 'type-title-xl' : 'type-title-lg';
---

<li class="md:grid md:grid-cols-8 md:gap-x-4 lg:grid-cols-7 lg:gap-x-5" data-reveal>
  <p class:list={[indexClass, 'text-decorative md:text-right']} aria-hidden="true" data-decorative>
    {index} /
  </p>
  <div class="mt-2 md:col-span-7 md:mt-0 lg:col-span-6">
    <slot />
  </div>
</li>

---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'textarea'>, 'id' | 'name' | 'class'> & {
  id: string;
  label: string;
  name: string;
  error?: string;
  class?: string;
};

const { id, label, name, error, class: className, ...textareaAttributes } = Astro.props;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class="type-eyebrow text-foreground">
    {label}
  </label>
  <textarea
    id={id}
    name={name}
    class="form-control type-field h-24 resize-none py-2.5"
    {...textareaAttributes}
  ></textarea>
  {error && (
    <p id={`${id}-error`} class="type-small text-foreground" data-field-error hidden>
      {error}
    </p>
  )}
</div>

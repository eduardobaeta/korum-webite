---
import type { LinkItem } from '@/components/types';
import Button from '@/components/ui/Button.astro';
import FlutedLight from '@/components/ui/FlutedLight.astro';
import LineBreaks from '@/components/ui/LineBreaks.astro';

interface Props {
  id: string;
  intro: string;
  primaryAction: LinkItem;
  secondaryAction: LinkItem;
  titleLines: readonly string[];
  meta: { year: string; location: string; venue: string };
}

const { id, intro, primaryAction, secondaryAction, titleLines, meta } = Astro.props;
---

<section id={id} class="relative bg-background">
  <!-- The orb bleeds into the next section, which has no background. -->
  <FlutedLight
    class="absolute -bottom-33.75 -left-34 aspect-square w-130 mix-blend-multiply md:-bottom-48 md:-left-42 md:w-170 lg:-bottom-89 lg:-left-52.5 lg:w-225"
    reveal={{ from: 0.6, duration: 1.4, delay: 1 }}
  />

  <div class="container-site relative flex min-h-svh flex-col justify-between pt-24 pb-8 md:pt-28 md:pb-10 lg:pt-36 lg:pb-12">
    <div class="relative">
      <p
        class="type-intro max-w-87.5 text-foreground md:max-w-105"
        data-reveal
        data-reveal-delay="0.1"
        data-reveal-duration="0.6"
      >
        {intro}
      </p>
      <div class="mt-6 flex items-center gap-4 md:gap-5" data-reveal data-reveal-delay="0.2" data-reveal-duration="0.6">
        <Button href={primaryAction.href}>{primaryAction.label}</Button>
        <Button href={secondaryAction.href} variant="text">
          {secondaryAction.label}
        </Button>
      </div>
    </div>

    <div class="relative flex flex-col-reverse gap-5 md:gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h1
        class="type-display text-foreground"
        data-reveal-words
        data-reveal-y="40"
        data-reveal-duration="0.8"
        data-reveal-delay="0.15"
      >
        <LineBreaks lines={titleLines} />
      </h1>

      <div
        class="flex shrink-0 flex-col lg:items-end lg:pb-1"
        data-reveal="fade"
        data-reveal-delay="0.9"
        data-reveal-duration="0.6"
      >
        <p class="type-numeral text-foreground">{meta.year}</p>
        <p class="type-eyebrow mt-2 flex gap-2">
          <span class="text-muted-foreground">{meta.location}</span>
          <span class="text-foreground">{meta.venue}</span>
        </p>
      </div>
    </div>
  </div>
</section>

---
import type { ComponentProps } from 'astro/types';
import IndexedItem from '@/components/ui/IndexedItem.astro';
import SectionIntro from '@/components/ui/SectionIntro.astro';
import TagList from '@/components/ui/TagList.astro';

interface Props {
  id: string;
  intro: Omit<ComponentProps<typeof SectionIntro>, 'sticky'>;
  items: readonly { index: string; title: string; text: string; tags: readonly string[] }[];
}

const { id, intro, items } = Astro.props;
---

<section id={id} class="section-space bg-background">
  <div class="container-site grid-site">
    <div class="col-span-full lg:col-span-4">
      <SectionIntro {...intro} sticky />
    </div>

    <ol class="col-span-full mt-12 flex flex-col gap-18 md:mt-16 md:gap-24 lg:col-span-7 lg:col-start-6 lg:mt-0 lg:gap-30">
      {items.map((item) => (
        <IndexedItem index={item.index} size="xl">
          <h3 class="type-title-xl text-foreground">{item.title}</h3>
          <p class="type-body mt-4 max-w-110 text-muted-foreground">{item.text}</p>
          <TagList items={item.tags} class="mt-6" />
        </IndexedItem>
      ))}
    </ol>
  </div>
</section>

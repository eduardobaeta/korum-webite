---
import type { ComponentProps } from 'astro/types';
import { VisitRequestForm } from '@/features/leads';
import type { LinkItem } from '@/components/types';
import Button from '@/components/ui/Button.astro';
import FlutedLight from '@/components/ui/FlutedLight.astro';
import LineBreaks from '@/components/ui/LineBreaks.astro';

interface Props {
  id: string;
  eyebrow: string;
  titleLines: readonly string[];
  lead: string;
  address: string;
  action: LinkItem;
  form: ComponentProps<typeof VisitRequestForm>;
}

const { id, eyebrow, titleLines, lead, address, action, form } = Astro.props;
---

<section id={id} class="bg-background pb-18 md:pt-6 md:pb-24 lg:pt-10 lg:pb-30">
  <div class="mx-auto max-w-360 md:px-8 lg:px-10">
    <div class="relative overflow-hidden px-5 py-12 md:px-10 md:py-14 lg:grid lg:grid-cols-12 lg:gap-x-5 lg:px-16 lg:py-18">
      <FlutedLight
        class="absolute inset-0 md:hidden"
        variant="panel"
        aspect={0.26}
        flutes={8}
        light={{ x: 0.3, y: 0.1, radius: 0.9 }}
      />
      <FlutedLight
        class="absolute inset-0 hidden md:block"
        variant="panel"
        aspect={1.47}
        light={{ x: 0.22, y: 0.3, radius: 0.36 }}
      />

      <div class="relative lg:col-span-5">
        <p class="type-eyebrow text-foreground" data-reveal>
          {eyebrow}
        </p>
        <h2 class="type-heading-md mt-6 text-foreground" data-reveal-words>
          <LineBreaks lines={titleLines} />
        </h2>
        <p class="type-lead mt-6 text-foreground" data-reveal>
          {lead}
        </p>
        <p class="type-emphasis mt-6 text-foreground" data-reveal>
          {address}
        </p>
        <div class="mt-3" data-reveal>
          <Button href={action.href} variant="text">
            {action.label}
          </Button>
        </div>
      </div>

      <div class="relative mt-14 md:mt-16 lg:col-span-6 lg:col-start-7 lg:mt-0" data-reveal>
        <VisitRequestForm {...form} />
      </div>
    </div>
  </div>
</section>

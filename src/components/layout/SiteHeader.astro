---
import CloseIcon from '@/assets/icons/close.svg';
import MenuIcon from '@/assets/icons/menu.svg';
import Button from '@/components/ui/Button.astro';
import { getContent } from '@/config/content';
import { LOCALES, localeSettings, localizePath, toLocale, unlocalizePath } from '@/config/i18n';
import { anchorTo, linkFrom, sectionIds, siteConfig } from '@/config/site';

const Logo = siteConfig.logo;
const locale = toLocale(Astro.currentLocale);
const { siteText } = getContent(locale);
const { interface: interfaceText, navigation: primaryNavigation, callToAction: primaryCallToAction } = siteText;
const href = (target: string) => linkFrom(Astro.url.pathname, target, locale);

const otherLocale = LOCALES.find((candidate) => candidate !== locale) ?? locale;
const languageSwitch = {
  href: localizePath(unlocalizePath(Astro.url.pathname), otherLocale),
  label: localeSettings[otherLocale].label,
  language: localeSettings[otherLocale].language,
  description: interfaceText.otherLanguage,
};
---

<!-- Blurs whatever scrolls behind the header; the mask fades the blur out instead of ending in a hard edge. -->
<div
  class="pointer-events-none fixed inset-x-0 top-0 z-9 h-24 bg-background/15 backdrop-blur-sm [mask-image:linear-gradient(to_bottom,#000_55%,transparent)] md:h-28 lg:h-30"
  aria-hidden="true"
></div>

<header class="pointer-events-none fixed inset-x-0 top-0 z-20">
  <div class="container-site flex items-center justify-between py-3 md:py-4 lg:py-6">
    <a href={href(anchorTo(sectionIds.top))} class="pointer-events-auto" aria-label={interfaceText.homeLink}>
      <!-- The artwork touches the viewBox edges; overflow-visible keeps the antialiased base of the letters. -->
      <Logo class="h-auto w-20 overflow-visible text-foreground" aria-hidden="true" />
    </a>

    <nav class="pointer-events-auto hidden items-center gap-8 lg:flex" aria-label={interfaceText.primaryNavigation}>
      <ul class="flex items-center gap-6">
        {primaryNavigation.map((item) => (
          <li>
            <a href={href(item.href)} class="type-nav text-foreground transition-opacity hover:opacity-60">
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={languageSwitch.href}
            hreflang={languageSwitch.language}
            lang={languageSwitch.language}
            aria-label={`${languageSwitch.label} · ${languageSwitch.description}`}
            class="type-nav text-foreground transition-opacity hover:opacity-60"
          >
            {languageSwitch.label}
          </a>
        </li>
      </ul>
      <Button href={href(primaryCallToAction.href)}>{primaryCallToAction.label}</Button>
    </nav>

    <button
      type="button"
      class="pointer-events-auto flex size-12 items-center justify-center rounded-full bg-foreground text-background lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label={interfaceText.openMenu}
      data-label-open={interfaceText.openMenu}
      data-label-close={interfaceText.closeMenu}
      data-menu-toggle
    >
      <MenuIcon class="size-6" aria-hidden="true" data-menu-icon="closed" />
      <CloseIcon class="hidden size-6" aria-hidden="true" data-menu-icon="open" />
    </button>
  </div>

  <div class="container-site lg:hidden">
    <nav
      id="mobile-navigation"
      class="invisible -mt-1 -translate-y-2 rounded-3xl bg-foreground p-6 opacity-0 transition-[opacity,translate,visibility] duration-300 ease-standard data-open:pointer-events-auto data-open:visible data-open:translate-y-0 data-open:opacity-100 md:-mt-2"
      aria-label={interfaceText.mobileNavigation}
      data-menu-panel
    >
      <ul class="flex flex-col gap-1.75">
        {primaryNavigation.map((item) => (
          <li>
            <a href={href(item.href)} class="type-menu block text-background" data-menu-link>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={href(primaryCallToAction.href)} variant="inverse" class="mt-3.5" data-menu-link>
        {primaryCallToAction.label}
      </Button>
      <a
        href={languageSwitch.href}
        hreflang={languageSwitch.language}
        lang={languageSwitch.language}
        class="type-nav mt-5 block text-background/70 transition-opacity hover:opacity-60"
      >
        {languageSwitch.description}
      </a>
    </nav>
  </div>
</header>

<script>
  import { pauseSmoothScroll, resumeSmoothScroll } from '@/scripts/motion/smooth-scroll';

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  function setMenuOpen(open: boolean): void {
    if (!toggle || !panel) return;

    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    toggle.querySelector('[data-menu-icon="closed"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-menu-icon="open"]')?.classList.toggle('hidden', !open);
    panel.toggleAttribute('data-open', open);

    if (open) pauseSmoothScroll();
    else resumeSmoothScroll();
  }

  const isMenuOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

  // Close before the smooth scroller handles the anchor (it ignores scrolling while paused).
  panel
    ?.querySelectorAll('[data-menu-link]')
    .forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isMenuOpen()) return;
    setMenuOpen(false);
    toggle?.focus();
  });

  window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });
</script>

---
import { createHash } from 'node:crypto';
import { Font } from 'astro:assets';
import '@/styles/globals.css';
import { isIndexable } from '@/config/deployment';
import { getContent } from '@/config/content';
import { LOCALES, localeSettings, localizePath, toLocale, unlocalizePath } from '@/config/i18n';
import { siteConfig } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const locale = toLocale(Astro.currentLocale);
const { siteText } = getContent(locale);
const { interface: interfaceText } = siteText;
const { title = siteText.title, description = siteText.description, noindex = false } = Astro.props;
const settings = localeSettings[locale];

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Social crawlers need absolute URLs, so the image is only declared when the site origin is known.
const socialImageUrl = Astro.site ? new URL(siteConfig.socialImage.path, Astro.site).href : undefined;
const robots = isIndexable && !noindex ? 'index, follow' : 'noindex, nofollow';

// Every indexable page exists in each locale at the same path, so its translations are announced to search engines.
const basePath = unlocalizePath(Astro.url.pathname);
const alternates =
  Astro.site && !noindex
    ? LOCALES.map((alternate) => ({
        hreflang: localeSettings[alternate].language,
        href: new URL(localizePath(basePath, alternate), Astro.site).href,
      }))
    : [];
const defaultAlternate = Astro.site && !noindex ? new URL(basePath, Astro.site).href : undefined;
const otherOpenGraphLocales = LOCALES.filter((other) => other !== locale).map(
  (other) => localeSettings[other].openGraphLocale,
);

// Inline so the class exists before first paint; Astro does not hash is:inline scripts, so the CSP gets it here.
const markScriptsEnabled = "document.documentElement.classList.add('js');";
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(markScriptsEnabled).digest('base64')}`);
---

<!doctype html>
<html lang={settings.language} data-smooth-scroll={String(siteConfig.smoothScroll)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate} />}
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={settings.openGraphLocale} />
    {otherOpenGraphLocales.map((other) => (
      <meta property="og:locale:alternate" content={other} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && (
      <Fragment>
        <meta property="og:image" content={socialImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(siteConfig.socialImage.width)} />
        <meta property="og:image:height" content={String(siteConfig.socialImage.height)} />
        <meta property="og:image:alt" content={siteText.socialImageAlt} />
      </Fragment>
    )}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-brand" preload={[{ weight: 500 }, { weight: 600 }]} />
    <script is:inline set:html={markScriptsEnabled} />
  </head>
  <body>
    <a
      href="#main-content"
      class="type-button sr-only z-30 rounded-full bg-primary px-5 py-3 text-primary-foreground focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {interfaceText.skipToContent}
    </a>
    <slot />

    <script>
      import { initMotion } from '@/scripts/motion';
      initMotion();
    </script>
  </body>
</html>
